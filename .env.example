# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=nexus_secret_password
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=nexus_auth_db,nexus_product_db,nexus_order_db,nexus_payment_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=redis_secret_password
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=nexus_mq
RABBITMQ_DEFAULT_PASS=rabbitmq_secret_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Container Names
POSTGRES_CONTAINER_NAME=Postgres
REDIS_CONTAINER_NAME=Redis
RABBITMQ_CONTAINER_NAME=RabbitMQ


# Service Secrets
AUTH_SECRET_KEY=your-64-char-cryptographic-auth-secret-key-here
AUTH_DEBUG=True
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1

PRODUCT_SECRET_KEY=your-64-char-cryptographic-product-secret-key-here
PRODUCT_DEBUG=True
PRODUCT_ALLOWED_HOSTS=localhost,127.0.0.1

ORDER_SECRET_KEY=your-64-char-cryptographic-order-secret-key-here
ORDER_DEBUG=True
ORDER_ALLOWED_HOSTS=localhost,127.0.0.1

JWT_SECRET_KEY=your-64-char-cryptographic-jwt-signing-key-here