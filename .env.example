# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=nexus_secret_password
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=nexus_auth_db,nexus_product_db,nexus_order_db,nexus_payment_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=redis_secret_password
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=nexus_mq
RABBITMQ_DEFAULT_PASS=rabbitmq_secret_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Container Names
POSTGRES_CONTAINER_NAME=Postgres
REDIS_CONTAINER_NAME=Redis
RABBITMQ_CONTAINER_NAME=RabbitMQ


# Auth Service Secrets
AUTH_SECRET_KEY=your-64-char-cryptographic-auth-secret-key-here
AUTH_DEBUG=True
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
AUTH_CONTAINER_NAME=AuthService
AUTH_PORT=8001
AUTH_DB_NAME=nexus_auth_db


# Product Service Secrets
PRODUCT_SECRET_KEY=your-64-char-cryptographic-product-secret-key-here
PRODUCT_DEBUG=True
PRODUCT_ALLOWED_HOSTS=localhost,127.0.0.1
PRODUCT_CONTAINER_NAME=ProductService
PRODUCT_PORT=8002
PRODUCT_DB_NAME=nexus_product_db


# Order Service Secrets
ORDER_SECRET_KEY=your-64-char-cryptographic-order-secret-key-here
ORDER_DEBUG=True
ORDER_ALLOWED_HOSTS=localhost,127.0.0.1
ORDER_CONTAINER_NAME=OrderService
ORDER_PORT=8003
ORDER_DB_NAME=nexus_order_db


# Payment Service Secrets
PAYMENT_WEBHOOK_SECRET=your-64-char-cryptographic-webhook-secret-key-here
PAYMENT_DEBUG=True
PAYMENT_CONTAINER_NAME=PaymentService
PAYMENT_PORT=8004
PAYMENT_DB_NAME=nexus_payment_db


# Notification Service Secrets
NOTIFICATION_CONTAINER_NAME=NotificationService


# API Gateway & Saga Worker Containers
GATEWAY_CONTAINER_NAME=ApiGateway
GATEWAY_PORT=8080
PRODUCT_WORKER_CONTAINER_NAME=ProductWorker
ORDER_WORKER_CONTAINER_NAME=OrderWorker
PAYMENT_WORKER_CONTAINER_NAME=PaymentWorker
NOTIFICATION_CONTAINER_NAME=NotificationService


# Monitoring & Observability (Prometheus & Grafana)
PROMETHEUS_CONTAINER_NAME=Prometheus
PROMETHEUS_PORT=9090
GRAFANA_CONTAINER_NAME=Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nexus_grafana_secret


# Shared Microservices JWT Verification Key
JWT_SECRET_KEY=your-64-char-cryptographic-jwt-signing-key-here